rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsEvent(eventId) {
      return signedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.organizerId == request.auth.uid &&
        request.resource.data.organizerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
    }

    match /registrations/{registrationId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || ownsEvent(resource.data.eventId));
      allow update, delete: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
